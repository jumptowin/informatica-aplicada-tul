<mxfile host="drawio" type="device"><diagram id="p1" name="MER Etapa 1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="MER — Bicicletas compartidas (Etapa 1)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#000000;align=left;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="-40" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c2" value='&lt;div style="text-align:center;font-size:13px"&gt;&lt;b&gt;TARJETA (medio de pago)&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;&lt;u&gt;&lt;b&gt;id_tarjeta&lt;/b&gt;&lt;/u&gt; (PK)&lt;br&gt;marca&lt;br&gt;ultimos_4_digitos&lt;br&gt;vencimiento (mm/aa)&lt;br&gt;&lt;i&gt;&lt;font style="font-size:10px"&gt;Nunca se guarda el número completo&lt;/font&gt;&lt;/i&gt;' style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="230" height="156" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="text-align:center;font-size:13px"&gt;&lt;b&gt;USUARIO&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;&lt;u&gt;&lt;b&gt;dni&lt;/b&gt;&lt;/u&gt; (PK)&lt;br&gt;nombre' style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="230" height="90" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center;font-size:13px"&gt;&lt;b&gt;BICICLETA&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;&lt;u&gt;&lt;b&gt;numero_serie&lt;/b&gt;&lt;/u&gt; (PK)&lt;br&gt;estado: DISPONIBLE / EN_USO /&lt;br&gt;&amp;nbsp;&amp;nbsp;EN_MANTENIMIENTO' style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="520" y="40" width="230" height="108" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="text-align:center;font-size:13px"&gt;&lt;b&gt;VIAJE (entidad débil)&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;&lt;u style="text-decoration-style:dashed"&gt;fecha_hora_inicio&lt;/u&gt; (clave parcial)&lt;br&gt;fecha_hora_fin (vacía si está en curso)&lt;br&gt;&lt;i&gt;&lt;font style="font-size:10px"&gt;Identificador: usuario + bicicleta +&lt;br&gt;fecha_hora_inicio&lt;/font&gt;&lt;/i&gt;' style="shape=ext;margin=4;double=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="520" y="320" width="230" height="120" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="text-align:center;font-size:13px"&gt;&lt;b&gt;ESTACION&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;&lt;u&gt;&lt;b&gt;codigo&lt;/b&gt;&lt;/u&gt; (PK)&lt;br&gt;direccion&lt;br&gt;capacidad_max' style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1000" y="320" width="230" height="108" as="geometry"/></mxCell><mxCell id="c7" value='&lt;div style="text-align:center;font-size:13px"&gt;&lt;b&gt;OPERARIO TÉCNICO&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;&lt;u&gt;&lt;b&gt;legajo&lt;/b&gt;&lt;/u&gt; (PK)&lt;br&gt;nombre' style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="520" y="680" width="230" height="90" as="geometry"/></mxCell><mx